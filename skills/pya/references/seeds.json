        "nc -z db 5432",
        "const sock = new net.Socket();"
      ]
    },
    {
      "id": "SEED-USER-INI-PREPEND",
      "agent": "threat-intel",
      "severity": "HIGH",
      "title": "auto_prepend_file set in .user.ini, php.ini or .htaccess",
      "regex": "(?i)^[ \\t]*(?:php_value[ \\t]+)?auto_prepend_file[ \\t]*=?[ \\t]*[\\\"']?[^\\s\\\"';=]",
