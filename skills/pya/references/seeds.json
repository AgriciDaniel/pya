      "regex": "(?m)^(?P<i>[ \\t]*)(?:-[ \\t]+)?run:[ \\t]*(?:[|>][^\\n]*\\n(?:[ \\t]*\\n|(?P=i)[ \\t]+[^\\n]*\\n)*?(?P=i)[ \\t]+[^\\n]*?|[^\\n]*?)(?P<hit>\\$\\{\\{\\s*(?:github\\.event\\.(?:issue\\.(?:title|body)|pull_request\\.(?:title|body|head\\.ref|head\\.label|head\\.repo\\.default_branch)|comment\\.body|review\\.body|review_comment\\.body|discussion\\.(?:title|body)|head_commit\\.(?:message|author\\.(?:name|email))|commits|pages|workflow_run\\.(?:head_branch|head_commit))|github\\.head_ref))",
